{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "WebOrigins": [],
    "PublicWebUrl": ""
  },
  "Auth": {
    "Cookie": {
      "Name": "__Host-qr_s",
      "Secure": true
    }
  },
  "Security": {
    "RecoveryPepper": "",
    "IpHashSalt": "",
    "ProxySecret": ""
  },
  "Storage": {
    "Provider": "s3",
    "ServiceUrl": "",
    "Region": "auto",
    "Bucket": "qrious-media",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": true,
    "PublicBaseUrl": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "RateLimiting": {
    "Enabled": true
  }
