# PostgreSQL (Neon in deployments; local docker compose in development)
DATABASE_URL=postgres://qrious:qrious_dev_password@localhost:5432/qrious_web
# Server secrets (min 16 chars; required in deployments)
QRIOUS_RECOVERY_PEPPER=dev-only-recovery-pepper-0123456789
QRIOUS_IP_SALT=dev-only-ip-salt-0123456789
# One-time token that lets the first organizer become platform admin (Organizer → Account → Admin bootstrap)
QRIOUS_ADMIN_BOOTSTRAP_TOKEN=
# Vercel Cron authorization for /api/v1/cron/maintenance
CRON_SECRET=
# Vercel Blob for photos/banners (local disk is used when unset)
BLOB_READ_WRITE_TOKEN=
# Razorpay TEST keys (payments stay disabled while empty — D-01)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public site URL (QR codes encode this origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
