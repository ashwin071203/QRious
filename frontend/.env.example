# Server-only: where the same-origin proxy sends /api/v1/* (the ASP.NET Core API)
API_INTERNAL_URL=http://localhost:5080
# Server-only: shared secret so the API trusts the forwarded client IP (must equal Security__ProxySecret on the API)
QRIOUS_PROXY_SECRET=dev-only-proxy-secret-0123456789
# Public site URL (used for metadata / share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
